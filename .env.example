# Copy to .env and fill in. The bot reads these on startup.

# --- Telegram (required) ---
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_TG_IDS=

# --- Database (async SQLAlchemy URL) ---
# PostgreSQL (default / production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_tracker
# SQLite (quick local run):
# DATABASE_URL=sqlite+aiosqlite:///./price_tracker.db

# --- Behaviour ---
DEFAULT_LOCALE=ru
DEFAULT_THRESHOLD_DELTA=5
POLL_INTERVAL_SECONDS=900
LOG_LEVEL=INFO

# --- Provider health / alerts ---
ALERT_COOLDOWN_HOURS=24
PROVIDER_ERROR_WINDOW_SECONDS=300
PROVIDER_ERROR_THRESHOLD=5

# --- Scraping ---
# Headless is convenient but easier for marketplaces to detect; set false to
# run a visible browser on a desktop/residential host.
HEADLESS_ENABLED=true
# Optional proxy pool (one proxy per line) or a single proxy URL.
# PROXY_FILE=proxies.txt
# PROXY_URL=
