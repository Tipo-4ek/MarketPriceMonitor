# Copy to .env and fill in. Every variable below maps to a field in
# bot/core/config.py; anything you leave out falls back to the default shown.

# --- Telegram (required) ---
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_TG_IDS=

# --- Postgres container (docker compose only) ---
# Required: docker compose refuses to start without it. Generate one, e.g.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=price_tracker

# --- Database (async SQLAlchemy URL) ---
# SQLite is the default and needs nothing installed:
DATABASE_URL=sqlite+aiosqlite:///./price_tracker.db
# PostgreSQL (what docker compose uses; fill in the password you set above):
# DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/price_tracker

# --- Behaviour ---
DEFAULT_LOCALE=ru
DEFAULT_THRESHOLD_DELTA=5
POLL_INTERVAL_SECONDS=900
LOG_LEVEL=INFO

# --- Provider health / alerts ---
ALERT_COOLDOWN_HOURS=24
# Must outlast the time it takes to accumulate the whole threshold: a provider
# is polled once per interval, so the Nth error lands (N-1) intervals after the
# first, and a shorter window ages the first out before the last arrives — the
# health state machine can then never leave OK. The bot refuses to start unless
# this exceeds (PROVIDER_ERROR_THRESHOLD - 1) * POLL_INTERVAL_SECONDS.
PROVIDER_ERROR_WINDOW_SECONDS=7200
PROVIDER_ERROR_THRESHOLD=5

# --- Browser ---
# Both marketplaces refuse headless browsers and refuse Playwright's bundled
# Chromium, so the defaults are "real Chrome, visible window". Changing either
# of these is useful for experiments; it is not a supported way to track prices.
HEADLESS_ENABLED=false
# Playwright browser channel. 'chrome' uses the Google Chrome you have
# installed; leave empty to fall back to Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome
# Where the browser profile lives. Keeping it means the anti-bot challenge is
# solved once rather than on every poll.
BROWSER_PROFILE_DIR=.browser-profile

# --- Politeness ---
# Minimum gap between two requests to the same marketplace. Marketplaces
# escalate against bursts from one address (see docs/marketplace-access.md), so
# lowering this makes tracking less reliable, not faster.
MIN_REQUEST_INTERVAL_SECONDS=30

# Optional proxy for the browser, e.g. http://user:pass@host:port
# PROXY_URL=

# --- Generic provider (any site), opt-in ---
# Off by default: enabling it points the real browser at any URL a user sends,
# so treat it as a deliberate choice. Every fetch is vetted (private/loopback/
# reserved addresses are refused, names are resolved and re-checked); see the
# README's security note before turning it on.
GENERIC_PROVIDER_ENABLED=false
# Extra hosts the generic provider must never fetch, on top of the built-in
# block. Comma-separated hostnames or IPs; a hostname also blocks its subdomains.
# A public deployment that enables the generic provider should list its own
# domains and public IP here.
# BLOCKED_HOSTS=example.com,203.0.113.7
